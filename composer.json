{
    "name": "david-grosskost/suitecrm-ext-pwa",
    "description": "Le CRM s'installe comme une application (PWA) sur téléphone et sur ordinateur, avec son nom et son icône.",
    "type": "suitecrm-extension",
    "license": "proprietary",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "david-grosskost/suitecrm-devkit": "^0.30"
    },
    "autoload-dev": {
        "psr-4": {
            "SuiteCrmExt\\Pwa\\": "legacy/include/pwa/",
            "SuiteCrmExt\\Pwa\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/david-grosskost/suitecrm-devkit",
            "no-api": true
        }
    ],
    "config": {
        "sort-packages": true
    }
}
